#!/usr/bin/env bash
set -euo pipefail

hook_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
eval_root=$(cd -- "$hook_dir/.." && pwd -P)
worktree=$(git rev-parse --show-toplevel)
output_dir=$eval_root/outputs

mkdir -p "$output_dir"
cp "$worktree/package.json" "$output_dir/package.json"
cp "$worktree/CHANGELOG.md" "$output_dir/CHANGELOG.md"
git -C "$worktree" log -1 --format='%s' >"$output_dir/release-commit.txt"
