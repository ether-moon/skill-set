#!/usr/bin/env bash

set -euo pipefail

if [[ ${0##*/} == skill-set-git ]]; then
  printf 'skill-set-git %s\n' "$*" >>"$MOCK_GH_LOG"
  printf 'the no-code shipping eval must never invoke skill-set-git\n' >&2
  exit 97
fi

printf '%s\n' "$*" >>"$MOCK_GH_LOG"
head_sha=$(<"$MOCK_GH_HEAD_FILE")

if [[ ${1:-} == pr && ${2:-} == list ]]; then
  printf '%s\n' '[]'
  exit 0
fi

if [[ ${1:-} == pr && ${2:-} == view ]]; then
  jq -cn --arg head "$head_sha" --arg base "$MOCK_GH_BASE_SHA" '
    {number:17,headRefOid:$head,headRefName:"feature",
      headRepository:{nameWithOwner:"owner/repo"},baseRefOid:$base,baseRefName:"main",
      mergeable:"MERGEABLE",mergeStateStatus:"CLEAN",state:"OPEN",
      url:"https://example.test/owner/repo/pull/17"}
  '
  exit 0
fi

if [[ ${1:-} == pr && ${2:-} == checks ]]; then
  printf '%s\n' '[{"bucket":"pass","name":"verify","state":"SUCCESS","link":"https://example.test/check/verify","workflow":"CI"}]'
  exit 0
fi

if [[ ${1:-} == api && ${2:-} == repos/*/rules/branches/* ]]; then
  printf '%s\n' '[{"type":"required_status_checks","parameters":{"required_status_checks":[{"context":"verify","integration_id":null}]}}]'
  exit 0
fi

if [[ ${1:-} == api && ${2:-} == repos/*/branches/*/protection/required_status_checks* ]]; then
  printf '%s\n' 'gh: Branch not protected (HTTP 404)' >&2
  exit 1
fi

if [[ ${1:-} == api && ${2:-} == graphql ]]; then
  graphql_id=
  graphql_body=
  for argument in "$@"; do
    case "$argument" in
      id=*) graphql_id=${argument#id=} ;;
      body=*) graphql_body=${argument#body=} ;;
    esac
  done
  # shellcheck disable=SC2016 # Match the literal GraphQL query fragment below.
  if [[ "$*" == *addPullRequestReviewThreadReply* ]]; then
    printf '%s\n' "$graphql_body" >"$MOCK_GH_DIR/$graphql_id.reply"
    printf '%s\n' '{"data":{"addPullRequestReviewThreadReply":{"comment":{"id":"reply-1"}}}}'
  elif [[ "$*" == *resolveReviewThread* ]]; then
    : >"$MOCK_GH_DIR/$graphql_id.resolved"
    jq -cn --arg id "$graphql_id" '{data:{resolveReviewThread:{thread:{id:$id,isResolved:true}}}}'
  elif [[ "$*" == *'node(id:$id)'* ]]; then
    resolved=false
    [[ ! -f $MOCK_GH_DIR/$graphql_id.resolved ]] || resolved=true
    reply_nodes='[]'
    if [[ -f $MOCK_GH_DIR/$graphql_id.reply ]]; then
      reply_nodes=$(jq -Rs '[{body:.}]' <"$MOCK_GH_DIR/$graphql_id.reply")
    fi
    jq -cn --arg id "$graphql_id" --argjson resolved "$resolved" --argjson replies "$reply_nodes" \
      '{data:{node:{id:$id,isResolved:$resolved,comments:{nodes:$replies}}}}'
  elif [[ -f $MOCK_GH_DIR/publication-complete ]]; then
    printf '%s\n' '{"data":{"repository":{"pullRequest":{"reviewThreads":{"nodes":[],"pageInfo":{"hasNextPage":false,"endCursor":null}}}}}}'
  else
    printf '%s\n' '{"data":{"repository":{"pullRequest":{"reviewThreads":{"nodes":[{"id":"thread-1","isResolved":false,"isOutdated":false,"comments":{"nodes":[{"id":"comment-1","author":{"login":"reviewer"},"body":"Please verify this request","path":"fixture.txt","line":1}]}}],"pageInfo":{"hasNextPage":false,"endCursor":null}}}}}}'
  fi
  exit 0
fi

if [[ ${1:-} == api && ${2:-} == repos/*/issues/*/comments* ]]; then
  if [[ -f $MOCK_GH_DIR/comment.body ]]; then
    jq -Rs '[{body:.}]' <"$MOCK_GH_DIR/comment.body"
  else
    printf '%s\n' '[]'
  fi
  exit 0
fi

if [[ ${1:-} == api && ${2:-} == repos/*/issues/*/reactions* ]]; then
  printf '%s\n' '[]'
  exit 0
fi

if [[ ${1:-} == api && ${2:-} == repos/*/commits/*/check-runs* ]]; then
  printf '%s\n' '{"check_runs":[]}'
  exit 0
fi

if [[ ${1:-} == api && ${2:-} == repos/*/commits/*/status ]]; then
  printf '%s\n' '{"statuses":[]}'
  exit 0
fi

if [[ ${1:-} == pr && ${2:-} == comment ]]; then
  body_file=
  while (($#)); do
    if [[ $1 == --body-file ]]; then
      [[ $# -ge 2 ]] || exit 64
      body_file=$2
      shift 2
    else
      shift
    fi
  done
  [[ -n $body_file && -f $body_file ]] || {
    printf 'mock gh requires --body-file\n' >&2
    exit 64
  }
  cp -- "$body_file" "$MOCK_GH_DIR/comment.body"
  : >"$MOCK_GH_DIR/publication-complete"
  printf '%s\n' '{"url":"https://example.test/comment/1"}'
  exit 0
fi

printf 'unsupported mock gh invocation: %s\n' "$*" >&2
exit 64
