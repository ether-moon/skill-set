#!/usr/bin/env bash

set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
plugin_dir=$(cd -- "$script_dir/.." && pwd)
repo_dir=$(cd -- "$plugin_dir/../.." && pwd)

usage() {
  printf '%s\n' \
    'Usage: run-evals [options]' \
    '' \
    'Run one explicitly selected evaluation stage after a stateless budget preflight.' \
    'No stage expands automatically and prior approval is never reused.' \
    '' \
    'Options:' \
    '  --candidate PATH       Candidate plugin directory (default: current plugin)' \
    '  --stage STAGE          development-smoke (default), focused-comparison, or campaign' \
    '  --case NAME            Exact case for development smoke or focused comparison' \
    '  --baseline MODE        none, no-plugin, or deletion-baseline' \
    '  --reason TEXT          Required purpose for focused comparison and campaign' \
    '  --baseline-ref REF     Compatibility option; deletion baseline is pinned to 95c1b2a' \
    '  --output-dir PATH      Result directory (default: evals/results/<timestamp>)' \
    '  --model MODEL          Evaluated model identifier (default: haiku)' \
    '  --judge-model MODEL    Qualitative grader identifier (default: sonnet)' \
    '  --runs N               Trials; smoke/focused require 1, campaign requires an explicit value' \
    '  --max-calls N          Preflight model-call limit (default: 4)' \
    '  --max-total-tokens N   Conservative preflight estimate, not a runtime hard cap (default: 100000)' \
    '  --estimated-tokens-per-call N' \
    '                         Equivalent-trace p95 estimate (fallback: 25000)' \
    '  --max-cost-usd USD     Optional secondary runtime ceiling for the current adapter' \
    '  --plan                 Print the validated preflight plan without invoking a model' \
    '  -h, --help             Show this help'
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || {
    printf 'Missing required command: %s\n' "$1" >&2
    exit 127
  }
}

positive_integer() {
  case $1 in ''|*[!0-9]*) return 1 ;; esac
  (($1 > 0))
}

snapshot_candidate() {
  local source=$1
  local destination=$2
  cp -R -- "$source" "$destination"
  rm -rf -- "$destination/.git" "$destination/evals/results"
  git -C "$destination" init -q
  git -C "$destination" add -f -- .
  git -C "$destination" write-tree
  rm -rf -- "$destination/.git"
}

candidate=$plugin_dir
stage=development-smoke
case_name=
baseline=none
baseline_explicit=false
reason=
deletion_baseline_ref=95c1b2a
deletion_baseline_sha=95c1b2a56b7b972f25bb9b5ae4c3cc942734b674
baseline_ref=$deletion_baseline_ref
output_dir=
model=haiku
judge_model=sonnet
max_cost_usd=
runs=
runs_explicit=false
max_calls=4
max_calls_explicit=false
max_total_tokens=100000
max_total_tokens_explicit=false
estimated_tokens_per_call=
plan_only=false

while (($#)); do
  case $1 in
    --candidate|--stage|--case|--baseline|--reason|--baseline-ref|--output-dir|--model|--judge-model|--max-cost-usd|--runs|--max-calls|--max-total-tokens|--estimated-tokens-per-call)
      (($# >= 2)) || { printf '%s requires a value\n' "$1" >&2; exit 2; }
      option=$1
      value=$2
      shift 2
      case $option in
        --candidate) candidate=$value ;;
        --stage) stage=$value ;;
        --case) case_name=$value ;;
        --baseline) baseline=$value; baseline_explicit=true ;;
        --reason) reason=$value ;;
        --baseline-ref) baseline_ref=$value ;;
        --output-dir) output_dir=$value ;;
        --model) model=$value ;;
        --judge-model) judge_model=$value ;;
        --max-cost-usd) max_cost_usd=$value ;;
        --runs) runs=$value; runs_explicit=true ;;
        --max-calls) max_calls=$value; max_calls_explicit=true ;;
        --max-total-tokens) max_total_tokens=$value; max_total_tokens_explicit=true ;;
        --estimated-tokens-per-call) estimated_tokens_per_call=$value ;;
      esac
      ;;
    --plan) plan_only=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

for dependency in bash git jq python3 ruby tar; do
  require_command "$dependency"
done
[[ -n $model ]] || { printf 'The evaluated model identifier cannot be empty.\n' >&2; exit 2; }
[[ -n $judge_model ]] || { printf 'The qualitative grader identifier cannot be empty.\n' >&2; exit 2; }
if [[ $runs_explicit == true ]] && ! positive_integer "$runs"; then
  printf 'Runs must be a positive integer.\n' >&2
  exit 2
fi
positive_integer "$max_calls" || { printf 'Max calls must be a positive integer.\n' >&2; exit 2; }
positive_integer "$max_total_tokens" || { printf 'Max total tokens must be a positive integer.\n' >&2; exit 2; }
if [[ -n $estimated_tokens_per_call ]] && ! positive_integer "$estimated_tokens_per_call"; then
  printf 'Estimated tokens per call must be a positive integer.\n' >&2
  exit 2
fi
if [[ -n $max_cost_usd ]] && ! jq -en --arg value "$max_cost_usd" \
  '$value | tonumber | isfinite and . > 0' >/dev/null 2>&1; then
  printf 'The cost ceiling must be a positive finite number.\n' >&2
  exit 2
fi
[[ -d $candidate/evals ]] || { printf 'Candidate has no evals directory: %s\n' "$candidate" >&2; exit 2; }
candidate=$(cd -- "$candidate" && pwd -P)
planner=$candidate/skills/creating-skills/scripts/plan_eval_budget.py
[[ -x $planner ]] || { printf 'Missing executable eval budget planner: %s\n' "$planner" >&2; exit 2; }

case $stage in
  development-smoke)
    [[ -n $case_name ]] || { printf 'Development smoke requires one exact --case.\n' >&2; exit 2; }
    [[ $baseline == none ]] || { printf 'Development smoke is candidate-only; --baseline must be none.\n' >&2; exit 2; }
    [[ $runs_explicit == false || $runs == 1 ]] || { printf 'Development smoke requires exactly one trial.\n' >&2; exit 2; }
    trials=1
    arms=(candidate)
    ;;
  focused-comparison)
    [[ -n $case_name ]] || { printf 'Focused comparison requires one exact --case.\n' >&2; exit 2; }
    [[ $baseline_explicit == true && ( $baseline == no-plugin || $baseline == deletion-baseline ) ]] || {
      printf 'Focused comparison requires --baseline no-plugin or deletion-baseline.\n' >&2
      exit 2
    }
    [[ -n $reason ]] || { printf 'Focused comparison requires a non-empty --reason.\n' >&2; exit 2; }
    [[ $max_calls_explicit == true && $max_total_tokens_explicit == true ]] || {
      printf 'Focused comparison requires explicit --max-calls and --max-total-tokens approval.\n' >&2
      exit 2
    }
    [[ $runs_explicit == false || $runs == 1 ]] || { printf 'Focused comparison requires exactly one trial.\n' >&2; exit 2; }
    trials=1
    arms=(candidate "$baseline")
    ;;
  campaign)
    [[ -z $case_name ]] || { printf 'Campaign runs the full suite and does not accept --case.\n' >&2; exit 2; }
    [[ $baseline_explicit == false || $baseline == none ]] || { printf 'Campaign arms are fixed; omit --baseline.\n' >&2; exit 2; }
    [[ -n $reason ]] || { printf 'Campaign requires a non-empty --reason.\n' >&2; exit 2; }
    [[ $runs_explicit == true ]] || { printf 'Campaign requires explicit --runs approval.\n' >&2; exit 2; }
    [[ $max_calls_explicit == true && $max_total_tokens_explicit == true ]] || {
      printf 'Campaign requires explicit --max-calls and --max-total-tokens approval.\n' >&2
      exit 2
    }
    trials=$runs
    arms=(candidate no-plugin deletion-baseline)
    ;;
  *) printf 'Unknown evaluation stage: %s\n' "$stage" >&2; exit 2 ;;
esac

case_inventory=$(ruby -rjson -ryaml -e '
  cases = Dir.glob(File.join(ARGV.fetch(0), "**", "case.yaml")).sort.map do |file|
    parsed = YAML.safe_load(File.read(file), permitted_classes: [], permitted_symbols: [], aliases: false)
    graders = Array(parsed["graders"])
    linked_graders = Dir.glob(File.join(File.dirname(file), "graders", "*.md")).count do |grader_file|
      frontmatter = File.read(grader_file).split(/^---\s*$\n?/)[1]
      next false unless frontmatter
      YAML.safe_load(frontmatter, permitted_classes: [], permitted_symbols: [], aliases: false)["type"] == "llm"
    end
    {name: parsed["name"], qualitative_graders: graders.count { |grader| grader["type"] == "llm" } + linked_graders}
  end
  abort "duplicate or invalid eval case names" unless cases.all? { |item| item[:name].is_a?(String) && !item[:name].empty? } && cases.map { |item| item[:name] }.uniq.length == cases.length
  puts JSON.generate(cases)
' "$candidate/evals")
if [[ $stage == campaign ]]; then
  selected_cases=$(jq '[.[].name]' <<<"$case_inventory")
  qualitative_graders=$(jq '[.[].qualitative_graders] | add // 0' <<<"$case_inventory")
else
  selected_count=$(jq --arg name "$case_name" '[.[] | select(.name == $name)] | length' <<<"$case_inventory")
  [[ $selected_count == 1 ]] || { printf 'Unknown evaluation case: %s\n' "$case_name" >&2; exit 2; }
  selected_cases=$(jq -nc --arg name "$case_name" '[$name]')
  qualitative_graders=$(jq --arg name "$case_name" '[.[] | select(.name == $name) | .qualitative_graders] | add // 0' <<<"$case_inventory")
fi
case_count=$(jq 'length' <<<"$selected_cases")
arm_count=${#arms[@]}
judge_calls=$((qualitative_graders * arm_count * trials))
normalized_model=$(printf '%s' "$model" | tr '[:upper:]' '[:lower:]')
normalized_judge=$(printf '%s' "$judge_model" | tr '[:upper:]' '[:lower:]')
if ((judge_calls > 0)) && [[ $normalized_model == "$normalized_judge" ]]; then
  printf 'Qualitative grading must use an independent model identifier.\n' >&2
  exit 2
fi

planner_args=(
  --cases "$case_count"
  --arms "$arm_count"
  --trials "$trials"
  --judge-calls "$judge_calls"
  --max-calls "$max_calls"
  --max-total-tokens "$max_total_tokens"
  --json
)
[[ -n $estimated_tokens_per_call ]] && planner_args+=(--estimated-tokens-per-call "$estimated_tokens_per_call")
set +e
budget_plan=$(python3 "$planner" "${planner_args[@]}")
budget_status=$?
set -e
if ((budget_status != 0)); then
  printf '%s\n' "$budget_plan"
  exit "$budget_status"
fi
arms_json=$(printf '%s\n' "${arms[@]}" | jq -R . | jq -s .)
eval_plan=$(jq -n \
  --argjson schema_version 1 \
  --arg stage "$stage" \
  --arg purpose "$reason" \
  --argjson selected_cases "$selected_cases" \
  --argjson arms "$arms_json" \
  --argjson trials "$trials" \
  --argjson budget "$budget_plan" \
  '{schema_version: $schema_version, stage: $stage, purpose: $purpose,
    selected_cases: $selected_cases, arms: $arms, trials: $trials, budget: $budget}')
needs_deletion_baseline=false
if [[ $stage == campaign || $baseline == deletion-baseline ]]; then needs_deletion_baseline=true; fi
if [[ $needs_deletion_baseline == true ]]; then
  [[ $baseline_ref == "$deletion_baseline_ref" ]] || {
    printf 'The deletion baseline is pinned to %s; refusing ref %s.\n' "$deletion_baseline_ref" "$baseline_ref" >&2
    exit 2
  }
  resolved_baseline_sha=$(git -C "$repo_dir" rev-parse --verify "$deletion_baseline_ref^{commit}")
  [[ $resolved_baseline_sha == "$deletion_baseline_sha" ]] || {
    printf 'Deletion baseline %s resolved to %s, expected %s.\n' "$deletion_baseline_ref" "$resolved_baseline_sha" "$deletion_baseline_sha" >&2
    exit 2
  }
fi
if [[ $plan_only == true ]]; then
  printf '%s\n' "$eval_plan"
  exit 0
fi

require_command claude
safety_contract=$candidate/evals/safety-contract.json
[[ -s $safety_contract ]] || { printf 'Candidate has no safety contract: %s\n' "$safety_contract" >&2; exit 2; }
jq -e '.schema_version == 1 and (.checks | type) == "array" and .operator_grants == ["Bash", "Write", "Edit"]' "$safety_contract" >/dev/null || {
  printf 'Candidate safety contract is invalid: %s\n' "$safety_contract" >&2
  exit 2
}
if [[ -z $output_dir ]]; then output_dir=$candidate/evals/results/$(date -u +%Y%m%dT%H%M%SZ); fi
mkdir -p -- "$output_dir"
printf '%s\n' "$eval_plan" >"$output_dir/eval-plan.json"
: >"$output_dir/arm-status.tsv"
temporary_dir=$(mktemp -d "${TMPDIR:-/tmp}/skill-set-evals.XXXXXX")
trap 'rm -rf -- "$temporary_dir"' EXIT

candidate_sha=$(git -C "$candidate" rev-parse HEAD 2>/dev/null || printf 'unversioned')
candidate_dirty=true
if candidate_git_root=$(git -C "$candidate" rev-parse --show-toplevel 2>/dev/null); then
  candidate_scope=$(git -C "$candidate" rev-parse --show-prefix)
  candidate_scope=${candidate_scope%/}
  candidate_state=$(mktemp "$temporary_dir/candidate-state.XXXXXX")
  candidate_pathspec=(.)
  if [[ -n $candidate_scope ]]; then candidate_pathspec=("$candidate_scope"); fi
  git -C "$candidate_git_root" diff --binary HEAD -- "${candidate_pathspec[@]}" >"$candidate_state"
  while IFS= read -r -d '' untracked_file; do
    executable=false
    [[ -x $candidate_git_root/$untracked_file ]] && executable=true
    printf 'untracked\0%s\0%s\0%s\0' "$untracked_file" \
      "$(git -C "$candidate_git_root" hash-object -- "$untracked_file")" "$executable" >>"$candidate_state"
  done < <(git -C "$candidate_git_root" ls-files --others --exclude-standard -z -- "${candidate_pathspec[@]}")
  if [[ ! -s $candidate_state ]]; then candidate_dirty=false; fi
fi

candidate_snapshot=$temporary_dir/candidate-plugin
candidate_fingerprint=$(snapshot_candidate "$candidate" "$candidate_snapshot")
snapshot_safety_contract=$candidate_snapshot/evals/safety-contract.json
[[ -s $snapshot_safety_contract ]] || { printf 'Candidate snapshot lost its safety contract.\n' >&2; exit 1; }
safety_contract_hash=$(git hash-object --no-filters "$snapshot_safety_contract")
cp -- "$snapshot_safety_contract" "$output_dir/safety-contract.json"

common_args=(--scaffold --keep-temp --threshold 0 --allow-tools Bash Write Edit)
common_args+=(--model "$model" --judge-model "$judge_model" --runs "$trials")
if [[ $stage != campaign ]]; then common_args+=(--case "$case_name"); fi
candidate_args=("${common_args[@]}")
baseline_args=("${common_args[@]}")
candidate_budget=
baseline_budget=
if [[ -n $max_cost_usd ]]; then
  candidate_arm_count=1
  [[ " ${arms[*]} " == *" no-plugin "* ]] && candidate_arm_count=2
  candidate_budget=$(jq -nr --arg budget "$max_cost_usd" --argjson candidate_arms "$candidate_arm_count" --argjson total_arms "$arm_count" '$budget | tonumber * $candidate_arms / $total_arms')
  candidate_args+=(--max-cost-usd "$candidate_budget")
  if [[ $needs_deletion_baseline == true ]]; then
    baseline_budget=$(jq -nr --arg budget "$max_cost_usd" --argjson total_arms "$arm_count" '$budget | tonumber / $total_arms')
    baseline_args+=(--max-cost-usd "$baseline_budget")
  fi
fi
candidate_ablation=none
if [[ " ${arms[*]} " == *" no-plugin "* ]]; then candidate_ablation=with-without; fi
candidate_snapshot_pr_runner=$candidate_snapshot/skills/shipping-pr/scripts/skill-set-pr
candidate_command=(claude plugin eval "$candidate_snapshot" --ablation "$candidate_ablation" "${candidate_args[@]}" --output-dir "$output_dir/candidate" --json "$output_dir/candidate.json")
if [[ -x $candidate_snapshot_pr_runner ]]; then
  candidate_command=(env SKILL_SET_PR_RUNNER="$candidate_snapshot_pr_runner" "${candidate_command[@]}")
fi

baseline_command=()
if [[ $needs_deletion_baseline == true ]]; then
  git -C "$repo_dir" archive "$deletion_baseline_sha" plugins/skill-set | tar -x -C "$temporary_dir"
  baseline_plugin=$temporary_dir/plugins/skill-set
  rm -rf -- "$baseline_plugin/evals"
  cp -R -- "$candidate_snapshot/evals" "$baseline_plugin/evals"
  rm -rf -- "$baseline_plugin/evals/results"
  baseline_pr_runner=$baseline_plugin/skills/shipping-pr/scripts/skill-set-pr
  if [[ ! -x $baseline_pr_runner ]]; then baseline_pr_runner=$baseline_plugin/bin/skill-set-pr; fi
  if [[ ! -x $baseline_pr_runner ]]; then baseline_pr_runner=$candidate_snapshot_pr_runner; fi
  if [[ ! -x $baseline_pr_runner ]]; then baseline_pr_runner=$plugin_dir/skills/shipping-pr/scripts/skill-set-pr; fi
  [[ -x $baseline_pr_runner ]] || { printf 'No executable PR runner is available for the deletion baseline.\n' >&2; exit 1; }
  baseline_command=(claude plugin eval "$baseline_plugin" --ablation none "${baseline_args[@]}" --output-dir "$output_dir/baseline" --json "$output_dir/baseline.json")
  baseline_command=(env SKILL_SET_PR_RUNNER="$baseline_pr_runner" "${baseline_command[@]}")
fi

run_eval_arm() {
  local arm=$1
  shift
  local status
  set +e
  "$@"
  status=$?
  set -e
  case $status in
    0) printf '%s\tcomplete\n' "$arm" >>"$output_dir/arm-status.tsv" ;;
    2)
      printf '%s\tpartial-budget\n' "$arm" >>"$output_dir/arm-status.tsv"
      printf 'Eval arm %s reached its adapter cost ceiling; preserving partial results.\n' "$arm" >&2
      ;;
    *)
      jq -n --arg arm "$arm" --argjson exit_code "$status" '{error: "eval-arm-failed", arm: $arm, exit_code: $exit_code}' >&2
      return "$status"
      ;;
  esac
}

run_eval_arm candidate "${candidate_command[@]}"
[[ -s $output_dir/candidate.json ]] || { printf 'Candidate eval produced no JSON result.\n' >&2; exit 1; }
retain_args=(--result "$output_dir/candidate.json" --trace-dir "$output_dir/traces" --with-arm candidate)
if [[ $candidate_ablation == with-without ]]; then retain_args+=(--without-arm no-plugin); fi
"$script_dir/retain-eval-traces" "${retain_args[@]}"
if [[ $needs_deletion_baseline == true ]]; then
  run_eval_arm deletion-baseline "${baseline_command[@]}"
  [[ -s $output_dir/baseline.json ]] || { printf 'Deletion baseline produced no JSON result.\n' >&2; exit 1; }
  "$script_dir/retain-eval-traces" --result "$output_dir/baseline.json" --trace-dir "$output_dir/traces" --with-arm deletion-baseline
fi

post_candidate_snapshot=$temporary_dir/post-candidate-plugin
post_candidate_fingerprint=$(snapshot_candidate "$candidate" "$post_candidate_snapshot")
post_candidate_sha=$(git -C "$candidate" rev-parse HEAD 2>/dev/null || printf 'unversioned')
post_safety_contract=$candidate/evals/safety-contract.json
post_safety_contract_hash=missing
if [[ -s $post_safety_contract ]]; then post_safety_contract_hash=$(git hash-object --no-filters "$post_safety_contract"); fi
candidate_sha_changed=false
candidate_fingerprint_changed=false
safety_contract_changed=false
[[ $post_candidate_sha == "$candidate_sha" ]] || candidate_sha_changed=true
[[ $post_candidate_fingerprint == "$candidate_fingerprint" ]] || candidate_fingerprint_changed=true
[[ $post_safety_contract_hash == "$safety_contract_hash" ]] || safety_contract_changed=true
if [[ $candidate_sha_changed == true || $candidate_fingerprint_changed == true || $safety_contract_changed == true ]]; then
  jq -n \
    --argjson candidate_sha_changed "$candidate_sha_changed" \
    --argjson candidate_fingerprint_changed "$candidate_fingerprint_changed" \
    --argjson safety_contract_changed "$safety_contract_changed" \
    '{error: "eval-input-drift", candidate_sha_changed: $candidate_sha_changed, candidate_fingerprint_changed: $candidate_fingerprint_changed, safety_contract_changed: $safety_contract_changed, acceptance: "discard"}' \
    >"$output_dir/provenance-drift.json"
  jq . "$output_dir/provenance-drift.json" >&2
  exit 1
fi

adapter_version=$(claude --version)
partial_budget=false
if awk -F '\t' '$2 == "partial-budget" {found=1} END {exit !found}' "$output_dir/arm-status.tsv"; then partial_budget=true; fi
metadata_baseline_ref=
metadata_baseline_sha=
if [[ $needs_deletion_baseline == true ]]; then
  metadata_baseline_ref=$deletion_baseline_ref
  metadata_baseline_sha=$deletion_baseline_sha
fi
jq -n \
  --arg stage "$stage" \
  --arg purpose "$reason" \
  --argjson arms "$arms_json" \
  --argjson selected_cases "$selected_cases" \
  --argjson trials "$trials" \
  --arg candidate_sha "$candidate_sha" \
  --argjson candidate_dirty "$candidate_dirty" \
  --arg candidate_fingerprint "$candidate_fingerprint" \
  --arg baseline_ref "$metadata_baseline_ref" \
  --arg baseline_sha "$metadata_baseline_sha" \
  --arg adapter_version "$adapter_version" \
  --arg model "$model" \
  --arg judge_model "$judge_model" \
  --arg max_cost_usd "$max_cost_usd" \
  --arg candidate_budget "$candidate_budget" \
  --arg baseline_budget "$baseline_budget" \
  --arg safety_contract_hash "$safety_contract_hash" \
  --argjson partial_budget "$partial_budget" \
  --arg generated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  '{stage: $stage, purpose: $purpose, arms: $arms, selected_cases: $selected_cases, trials: $trials,
    eval_plan: "eval-plan.json", candidate_sha: $candidate_sha, candidate_dirty: $candidate_dirty,
    candidate_fingerprint: $candidate_fingerprint, baseline_ref: $baseline_ref, baseline_sha: $baseline_sha,
    evaluation_adapter_version: $adapter_version, claude_version: $adapter_version,
    model: $model, judge_model: $judge_model, resolved_model_snapshot: null, resolved_judge_snapshot: null,
    model_resolution_note: "The active evaluation adapter reports requested identifiers but not resolved snapshot IDs",
    max_cost_usd: $max_cost_usd,
    cost_allocation: {candidate: $candidate_budget, deletion_baseline: $baseline_budget, semantics: "optional adapter runtime ceilings; independent from the token preflight estimate"},
    partial_budget: $partial_budget, runs: ($trials | tostring), filters: {case: ($selected_cases | join(",")), tags: []},
    generated_at: $generated_at, operator_tool_grants: ["Bash", "Write", "Edit"],
    operator_tool_grant_note: "Adapter grants apply to an invocation; mutation acceptance also requires deterministic safety evidence and retained traces",
    baseline_normalization: [], safety_contract: {path: "safety-contract.json", hash_algorithm: "git-hash-object", hash: $safety_contract_hash},
    trace_retention: {path: "traces", source: "agent event stream", cleanup: "verified adapter temporary roots only"}, human_review_required: true}' \
  >"$output_dir/metadata.json"

summary_args=(
  --stage "$stage"
  --candidate "$output_dir/candidate.json"
  --metadata "$output_dir/metadata.json"
  --plan "$output_dir/eval-plan.json"
  --safety-contract "$output_dir/safety-contract.json"
  --output "$output_dir/acceptance-summary.json"
)
if [[ $needs_deletion_baseline == true ]]; then summary_args+=(--baseline "$output_dir/baseline.json"); fi
"$script_dir/summarize-evals" "${summary_args[@]}"

if [[ $needs_deletion_baseline == true ]]; then
  jq -n \
    --slurpfile plan "$output_dir/eval-plan.json" \
    --slurpfile metadata "$output_dir/metadata.json" \
    --slurpfile candidate "$output_dir/candidate.json" \
    --slurpfile baseline_result "$output_dir/baseline.json" \
    --slurpfile acceptance "$output_dir/acceptance-summary.json" \
    '{plan: $plan[0], metadata: $metadata[0], candidate: $candidate[0], deletion_baseline: $baseline_result[0], acceptance_review: $acceptance[0]}' \
    >"$output_dir/combined-results.json"
else
  jq -n \
    --slurpfile plan "$output_dir/eval-plan.json" \
    --slurpfile metadata "$output_dir/metadata.json" \
    --slurpfile candidate "$output_dir/candidate.json" \
    --slurpfile acceptance "$output_dir/acceptance-summary.json" \
    '{plan: $plan[0], metadata: $metadata[0], candidate: $candidate[0], deletion_baseline: null, acceptance_review: $acceptance[0]}' \
    >"$output_dir/combined-results.json"
fi

summary_status=$(jq -r '.status' "$output_dir/acceptance-summary.json")
run_status='runs-finished'
if [[ $partial_budget == true ]]; then run_status=partial-budget; fi
if [[ $summary_status == invalid ]]; then run_status=invalid-evidence; fi
jq -n --arg status "$run_status" --arg output_dir "$output_dir" --arg stage "$stage" --argjson arms "$arms_json" \
  '{status: $status, output_dir: $output_dir, stage: $stage, arms: $arms, review_required: true}'
[[ $summary_status != invalid ]]
