#!/usr/bin/env bash

set -euo pipefail

printf '%s\n' "$*" >>"$MOCK_GH_LOG"

if [[ ${0##*/} == skill-set-git ]]; then
  [[ ${1:-} == push ]] || { printf 'unsupported mock skill-set-git invocation\n' >&2; exit 64; }
  if [[ $MOCK_GH_SCENARIO == publication-push-fail ]]; then
    printf '%s\n' '{"ok":false,"error":{"code":"mock_push_failed"}}' >&2
    exit 1
  fi
  local_head=$(git rev-parse HEAD)
  printf '%s\n' "$local_head" >"$MOCK_GH_HEAD_FILE"
  if [[ $MOCK_GH_SCENARIO == publication-malformed-push ]]; then
    printf '%s\n' '{not-json'
  else
    jq -cn --arg sha "$local_head" '{ok:true,pushed:true,remote_sha:$sha}'
  fi
  exit 0
fi

next_count() {
  local name=$1
  local file=$MOCK_GH_DIR/$name.count
  local count=0
  [[ -f $file ]] && count=$(<"$file")
  count=$((count + 1))
  printf '%s\n' "$count" >"$file"
  printf '%s\n' "$count"
}

if [[ ${1:-} == repo && ${2:-} == view ]]; then
  printf '%s\n' '{"nameWithOwner":"owner/repo"}'
  exit 0
fi

if [[ ${1:-} == pr && ${2:-} == list ]]; then
  if [[ $MOCK_GH_SCENARIO == malformed-pr-list ]]; then
    printf '%s\n' '[{"reviews":42,"comments":[]}]'
  elif [[ $MOCK_GH_SCENARIO == reviewers-active ]]; then
    printf '%s\n' '[{"reviews":[{"author":{"login":"coderabbitai[bot]"}},{"author":{"login":"claude[bot]"}},{"author":{"login":"chatgpt-codex-connector[bot]"}}],"comments":[]}]'
  elif [[ $MOCK_GH_SCENARIO == codex-reaction || $MOCK_GH_SCENARIO == codex-unresolved ]]; then
    printf '%s\n' '[{"reviews":[{"author":{"login":"chatgpt-codex-connector[bot]"}}],"comments":[]}]'
  elif [[ $MOCK_GH_SCENARIO == claude-review ]]; then
    printf '%s\n' '[{"reviews":[{"author":{"login":"claude[bot]"}}],"comments":[]}]'
  elif [[ $MOCK_GH_SCENARIO == signal-gated-* ]]; then
    printf '%s\n' '[{"reviews":[{"author":{"login":"claude[bot]"}},{"author":{"login":"chatgpt-codex-connector[bot]"}}],"comments":[]}]'
  elif [[ $MOCK_GH_SCENARIO == coderabbit-* || $MOCK_GH_SCENARIO == malformed-coderabbit ]]; then
    printf '%s\n' '[{"reviews":[{"author":{"login":"coderabbitai[bot]"}}],"comments":[]}]'
  else
    printf '%s\n' '[]'
  fi
  exit 0
fi

if [[ ${1:-} == pr && ${2:-} == view ]]; then
  count=$(next_count pr-view)
  if [[ $MOCK_GH_SCENARIO == malformed ]]; then
    printf '%s\n' '{not-json'
    exit 0
  fi
  sha=$MOCK_GH_HEAD
  [[ ! -f $MOCK_GH_HEAD_FILE ]] || sha=$(<"$MOCK_GH_HEAD_FILE")
  head_repo=${MOCK_GH_HEAD_REPO:-owner/repo}
  head_branch=${MOCK_GH_HEAD_BRANCH:-feature}
  github_host=${MOCK_GH_HOST:-example.test}
  if [[ $MOCK_GH_SCENARIO == head-change && $count -gt 1 ]]; then
    sha=$MOCK_GH_NEW_HEAD
  elif [[ $MOCK_GH_SCENARIO == head-race && $count -gt 2 ]]; then
    sha=$MOCK_GH_NEW_HEAD
  fi
  if [[ $MOCK_GH_SCENARIO == publication-remote-race && $count -eq 6 ]]; then
    git remote set-url origin https://example.test/attacker/repo.git
  fi
  mergeable=MERGEABLE
  merge_state=CLEAN
  pr_state=OPEN
  reviews='[]'
  comments='[]'
  if [[ $MOCK_GH_SCENARIO == reviewers-active ]]; then
    reviews=$(jq -cn --arg sha "$sha" '[{author:{login:"chatgpt-codex-connector[bot]"},commit:{oid:$sha},state:"COMMENTED"}]')
  elif [[ $MOCK_GH_SCENARIO == claude-review ]]; then
    reviews=$(jq -cn --arg sha "$sha" '[{author:{login:"claude[bot]"},commit:{oid:$sha},state:"COMMENTED"}]')
  fi
  if [[ $MOCK_GH_SCENARIO == conflict ]]; then
    mergeable=CONFLICTING
    merge_state=DIRTY
  elif [[ $MOCK_GH_SCENARIO == merge-state-blocked ]]; then
    merge_state=BLOCKED
  elif [[ $MOCK_GH_SCENARIO == closed ]]; then
    pr_state=CLOSED
  elif [[ $MOCK_GH_SCENARIO == close-race && $count -gt 2 ]]; then
    pr_state=CLOSED
  fi
  jq -cn --arg sha "$sha" --arg base "$MOCK_GH_BASE_SHA" --arg mergeable "$mergeable" \
    --arg merge_state "$merge_state" --arg state "$pr_state" --arg head_repo "$head_repo" \
    --arg head_branch "$head_branch" --arg host "$github_host" \
    --argjson reviews "$reviews" --argjson comments "$comments" \
    '{number:17,headRefOid:$sha,headRefName:$head_branch,
      headRepository:{nameWithOwner:$head_repo},baseRefOid:$base,baseRefName:"main",
      mergeable:$mergeable,mergeStateStatus:$merge_state,state:$state,
      url:("https://" + $host + "/owner/repo/pull/17"),reviews:$reviews,comments:$comments}'
  exit 0
fi

if [[ ${1:-} == api && ${2:-} == repos/*/rules/branches/* ]]; then
  if [[ $MOCK_GH_SCENARIO == malformed-rules ]]; then
    printf '%s\n' '[{"type":"required_status_checks","parameters":{"required_status_checks":[{"context":42}]}}]'
  elif [[ $MOCK_GH_SCENARIO == missing-required-review ]]; then
    jq -cn '[{type:"required_status_checks",parameters:{required_status_checks:[
      {context:"verify",integration_id:null},
      {context:"signal-gated-review",integration_id:null}
    ]}}]'
  elif [[ $MOCK_GH_SCENARIO == no-required ]]; then
    printf '%s\n' '[]'
  elif [[ $MOCK_GH_SCENARIO == signal-gated-* ]]; then
    jq -cn '[{type:"required_status_checks",parameters:{required_status_checks:[
      {context:"review",integration_id:null}
    ]}}]'
  else
    jq -cn '[{type:"required_status_checks",parameters:{required_status_checks:[
      {context:"verify",integration_id:null}
    ]}}]'
  fi
  exit 0
fi

if [[ ${1:-} == api && ${2:-} == repos/*/branches/*/protection/required_status_checks* ]]; then
  if [[ $MOCK_GH_SCENARIO == legacy-missing-required ]]; then
    printf '%s\n' '{"strict":false,"contexts":["legacy-review"],"checks":[]}'
    exit 0
  elif [[ $MOCK_GH_SCENARIO == malformed-protection ]]; then
    printf '%s\n' '{"strict":false,"contexts":[42],"checks":[]}'
    exit 0
  fi
  printf '%s\n' 'gh: Branch not protected (HTTP 404)' >&2
  exit 1
fi

if [[ ${1:-} == pr && ${2:-} == comment ]]; then
  body_file=
  while [[ $# -gt 0 ]]; do
    if [[ $1 == --body-file ]]; then body_file=$2; shift 2; else shift; fi
  done
  [[ -n $body_file && -f $body_file ]] || { printf 'missing body file\n' >&2; exit 64; }
  if [[ $MOCK_GH_SCENARIO == publication-comment-fail ]]; then
    printf 'mock comment failure\n' >&2
    exit 1
  fi
  command cp "$body_file" "$MOCK_GH_DIR/comment.body"
  printf '%s\n' '{"url":"https://example.test/comment/1"}'
  exit 0
fi

if [[ ${1:-} == pr && ${2:-} == checks ]]; then
  count=$(next_count checks)
  if [[ $MOCK_GH_SCENARIO == malformed-checks ]]; then
    printf '%s\n' '[1]'
    exit 0
  fi
  if [[ $MOCK_GH_SCENARIO == no-required ]]; then
    printf "%s\n" "no required checks reported on the 'feature' branch" >&2
    exit 1
  fi
  if [[ $MOCK_GH_SCENARIO == missing-required-review && $count -gt 1 ]]; then
    jq -cn '[
      {bucket:"pass",name:"verify",state:"PASS",link:"https://example.test/check/verify",workflow:"CI"},
      {bucket:"pass",name:"signal-gated-review",state:"PASS",link:"https://example.test/check/signal-gated-review",workflow:"Signal-Gated PR Review"}
    ]'
    exit 0
  fi
  bucket=$MOCK_GH_SCENARIO
  check_name=verify
  workflow=CI
  if [[ $MOCK_GH_SCENARIO == signal-gated-running ]]; then
    bucket=pending
    check_name=review
    workflow='Signal-Gated PR Review'
  elif [[ $MOCK_GH_SCENARIO == signal-gated-complete || $MOCK_GH_SCENARIO == signal-gated-thread ]]; then
    bucket=pass
    check_name=review
    workflow='Signal-Gated PR Review'
  elif [[ $MOCK_GH_SCENARIO == coderabbit-fingerprint ]]; then
    bucket=pending
  elif [[ $MOCK_GH_SCENARIO == registration-delay ]]; then
    if [[ $count -eq 1 ]]; then
      printf "%s\n" "no required checks reported on the 'feature' branch" >&2
      exit 1
    elif [[ $count -eq 2 ]]; then
      bucket=pending
    else
      bucket=pass
    fi
  elif [[ $MOCK_GH_SCENARIO == fail-a ]]; then
    bucket=fail
    check_name=lint
  elif [[ $MOCK_GH_SCENARIO == fail-b ]]; then
    bucket=fail
    check_name='test'
  elif [[ $MOCK_GH_SCENARIO == missing-required-review ]]; then
    bucket=pass
  elif [[ $MOCK_GH_SCENARIO == legacy-missing-required ]]; then
    bucket=pass
  fi
  [[ $bucket == delayed && $count -eq 1 ]] && bucket=pending
  [[ $bucket == delayed && $count -gt 1 ]] && bucket=pass
  case "$bucket" in
    fail|cancel|pending|pass|skipping) ;;
    *) bucket=pass ;;
  esac
  jq -cn --arg bucket "$bucket" --arg name "$check_name" --arg workflow "$workflow" \
    '[{bucket:$bucket,name:$name,state:($bucket | ascii_upcase),link:("https://example.test/check/" + $name),workflow:$workflow}]'
  case "$bucket" in
    pending) exit 8 ;;
    fail|cancel) exit 1 ;;
    *) exit 0 ;;
  esac
fi

if [[ ${1:-} == api && ${2:-} == graphql ]]; then
  graphql_id=
  graphql_body=
  for argument in "$@"; do
    case "$argument" in
      id=*) graphql_id=${argument#id=} ;;
      body=*) graphql_body=${argument#body=} ;;
    esac
  done
  # shellcheck disable=SC2016 # Match the literal GraphQL query fragment below.
  if [[ "$*" == *addPullRequestReviewThreadReply* ]]; then
    printf '%s\n' "$graphql_body" >"$MOCK_GH_DIR/$graphql_id.reply"
    printf '%s\n' '{"data":{"addPullRequestReviewThreadReply":{"comment":{"id":"reply-1"}}}}'
  elif [[ "$*" == *resolveReviewThread* ]]; then
    : >"$MOCK_GH_DIR/$graphql_id.resolved"
    jq -cn --arg id "$graphql_id" '{data:{resolveReviewThread:{thread:{id:$id,isResolved:true}}}}'
  elif [[ "$*" == *'node(id:$id)'* ]]; then
    resolved=false
    [[ ! -f $MOCK_GH_DIR/$graphql_id.resolved ]] || resolved=true
    reply_nodes='[]'
    if [[ -f $MOCK_GH_DIR/$graphql_id.reply ]]; then
      reply_nodes=$(jq -Rs '[{body:.}]' <"$MOCK_GH_DIR/$graphql_id.reply")
    fi
    jq -cn --arg id "$graphql_id" --argjson resolved "$resolved" --argjson replies "$reply_nodes" \
      '{data:{node:{id:$id,isResolved:$resolved,comments:{nodes:$replies}}}}'
  elif [[ "$*" == *'reviews(first:100'* ]]; then
    if [[ $MOCK_GH_SCENARIO == malformed-reviews ]]; then
      jq -cn '{data:{repository:{pullRequest:{reviews:{nodes:[{
        id:"review-malformed",state:"COMMENTED",body:42,updatedAt:"2026-09-04T00:00:00Z"
      }],pageInfo:{hasNextPage:false,endCursor:null}}}}}}'
    elif [[ $MOCK_GH_SCENARIO == unthreaded-review ]]; then
      jq -cn --arg sha "$(<"$MOCK_GH_HEAD_FILE")" \
        '{data:{repository:{pullRequest:{reviews:{nodes:[{
          id:"review-unthreaded",state:"COMMENTED",
          body:"Suggestion: inspect this before declaring the PR clean.",
          submittedAt:"2026-09-04T00:00:00Z",updatedAt:"2026-09-04T00:00:00Z",
          commit:{oid:$sha},author:{login:"github-actions"}
        }],pageInfo:{hasNextPage:false,endCursor:null}}}}}}'
    else
      jq -cn '{data:{repository:{pullRequest:{reviews:{nodes:[],pageInfo:{hasNextPage:false,endCursor:null}}}}}}'
    fi
  elif [[ $MOCK_GH_SCENARIO == malformed-threads ]]; then
    jq -cn '{data:{repository:{pullRequest:{reviewThreads:{nodes:[{id:"thread-1",isResolved:false,isOutdated:false,comments:{nodes:[{body:42}]}}],pageInfo:{hasNextPage:false,endCursor:null}}}}}}'
  elif [[ $MOCK_GH_SCENARIO == pagination ]]; then
    if [[ "$*" == *'cursor=page-2'* ]]; then
      jq -cn '{data:{repository:{pullRequest:{reviewThreads:{nodes:[{id:"thread-101",isResolved:false,isOutdated:false,comments:{nodes:[{author:{login:"reviewer"},body:"Page two blocker",path:"fixture.txt",line:1}]}}],pageInfo:{hasNextPage:false,endCursor:null}}}}}}'
    else
      jq -cn '{data:{repository:{pullRequest:{reviewThreads:{nodes:[range(0;100) | {id:("thread-" + tostring),isResolved:true,isOutdated:false,comments:{nodes:[]}}],pageInfo:{hasNextPage:true,endCursor:"page-2"}}}}}}'
    fi
  elif [[ $MOCK_GH_SCENARIO == coderabbit-unresolved ]]; then
    jq -cn '{data:{repository:{pullRequest:{reviewThreads:{nodes:[{id:"thread-coderabbit",isResolved:false,isOutdated:false,comments:{nodes:[{id:"comment-coderabbit",author:{login:"coderabbitai[bot]"},body:"Please fix this",path:"fixture.txt",line:1}]}}],pageInfo:{hasNextPage:false,endCursor:null}}}}}}'
  elif [[ $MOCK_GH_SCENARIO == codex-unresolved ]]; then
    jq -cn '{data:{repository:{pullRequest:{reviewThreads:{nodes:[{id:"thread-codex",isResolved:false,isOutdated:false,comments:{nodes:[{id:"comment-codex",author:{login:"chatgpt-codex-connector[bot]"},body:"Please fix this",path:"fixture.txt",line:1}]}}],pageInfo:{hasNextPage:false,endCursor:null}}}}}}'
  elif [[ $MOCK_GH_SCENARIO == signal-gated-thread ]]; then
    jq -cn '{data:{repository:{pullRequest:{reviewThreads:{nodes:[{id:"thread-signal-gated",isResolved:false,isOutdated:false,comments:{nodes:[{author:{login:"github-actions[bot]"},body:"Please address this review finding",path:"fixture.txt",line:1}]}}],pageInfo:{hasNextPage:false,endCursor:null}}}}}}'
  elif [[ $MOCK_GH_SCENARIO == unresolved ]]; then
    jq -cn '{data:{repository:{pullRequest:{reviewThreads:{nodes:[{id:"thread-1",isResolved:false,isOutdated:false,comments:{nodes:[{author:{login:"reviewer"},body:"Please fix this",path:"fixture.txt",line:1}]} }],pageInfo:{hasNextPage:false,endCursor:null}}}}}}'
  elif [[ $MOCK_GH_SCENARIO == praise-only ]]; then
    jq -cn '{data:{repository:{pullRequest:{reviewThreads:{nodes:[{id:"thread-praise",isResolved:false,isOutdated:false,comments:{nodes:[{author:{login:"reviewer"},body:"LGTM!",path:"fixture.txt",line:1}]}}],pageInfo:{hasNextPage:false,endCursor:null}}}}}}'
  elif [[ $MOCK_GH_SCENARIO == praise-with-request ]]; then
    jq -cn '{data:{repository:{pullRequest:{reviewThreads:{nodes:[{id:"thread-request",isResolved:false,isOutdated:false,comments:{nodes:[{author:{login:"reviewer"},body:"LGTM, but please fix this",path:"fixture.txt",line:1}]}}],pageInfo:{hasNextPage:false,endCursor:null}}}}}}'
  elif [[ $MOCK_GH_SCENARIO == thread-change ]]; then
    count=$(next_count graphql)
    body='First request'
    [[ $count -gt 1 ]] && body='Updated request with different requirements'
    jq -cn --arg body "$body" '{data:{repository:{pullRequest:{reviewThreads:{nodes:[{id:"thread-1",isResolved:false,isOutdated:false,comments:{nodes:[{author:{login:"reviewer"},body:$body,path:"fixture.txt",line:1}]}}],pageInfo:{hasNextPage:false,endCursor:null}}}}}}'
  else
    jq -cn '{data:{repository:{pullRequest:{reviewThreads:{nodes:[],pageInfo:{hasNextPage:false,endCursor:null}}}}}}'
  fi
  exit 0
fi

if [[ ${1:-} == api && ${2:-} == repos/*/issues/*/comments* ]]; then
  if [[ -f $MOCK_GH_DIR/comment.body ]]; then
    jq -Rs '[{body:.}]' <"$MOCK_GH_DIR/comment.body"
  else
    printf '%s\n' '[]'
  fi
  exit 0
fi

if [[ ${1:-} == api && ${2:-} == repos/*/issues/*/reactions* ]]; then
  if [[ $MOCK_GH_SCENARIO == codex-reaction ]]; then
    printf '%s\n' '[{"content":"+1","user":{"login":"chatgpt-codex-connector[bot]"}}]'
  else
    printf '%s\n' '[]'
  fi
  exit 0
fi

if [[ ${1:-} == api && ${2:-} == repos/*/commits/*/check-runs* ]]; then
  if [[ $MOCK_GH_SCENARIO == reviewers-active ]]; then
    printf '%s\n' '{"check_runs":[{"name":"CodeRabbit","status":"completed","conclusion":"success","app":{"slug":"coderabbitai"}},{"name":"Claude Code Review","status":"completed","conclusion":"neutral","app":{"slug":"claude"}}]}'
  elif [[ $MOCK_GH_SCENARIO == coderabbit-check-delay ]]; then
    count=$(next_count coderabbit-check)
    if [[ $count -eq 1 ]]; then
      printf '%s\n' '{"check_runs":[{"name":"CodeRabbit","status":"in_progress","conclusion":null,"app":{"slug":"coderabbitai"}}]}'
    else
      printf '%s\n' '{"check_runs":[{"name":"CodeRabbit","status":"completed","conclusion":"success","app":{"slug":"coderabbitai"}}]}'
    fi
  else
    printf '%s\n' '{"check_runs":[]}'
  fi
  exit 0
fi

if [[ ${1:-} == api && ${2:-} == repos/*/commits/*/status ]]; then
  state=absent
  if [[ $MOCK_GH_SCENARIO == malformed-coderabbit ]]; then
    printf '%s\n' '{"statuses":[{"context":42,"state":"success"}]}'
    exit 0
  elif [[ $MOCK_GH_SCENARIO == coderabbit-delay ]]; then
    count=$(next_count coderabbit)
    state=pending
    [[ $count -gt 1 ]] && state=success
  elif [[ $MOCK_GH_SCENARIO == coderabbit-fingerprint ]]; then
    count=$(next_count coderabbit)
    state=pending
    [[ $count -gt 1 ]] && state=success
  elif [[ $MOCK_GH_SCENARIO == coderabbit-failure ]]; then
    state=failure
  elif [[ $MOCK_GH_SCENARIO == reviewers-active ]]; then
    state=success
  fi
  if [[ $state == absent ]]; then
    printf '%s\n' '{"statuses":[]}'
  else
    jq -cn --arg state "$state" '{statuses:[{context:"CodeRabbit",state:$state}]}'
  fi
  exit 0
fi

printf 'unsupported mock gh invocation: %s\n' "$*" >&2
exit 64
